/* Structural layout + polish for the soap TUI. All colors come from the active
   theme ($background/$surface/$panel/$primary/$accent/$border/$text-muted…), so
   switching themes reskins everything without touching this file. The Aqua Slate
   system: quiet $border on every pane, teal $primary on the focused one. */

/* Leave the root at the terminal's default background so the terminal's own
   (possibly transparent) background shows through — like lazygit/Claude Code.
   `ansi_default` emits the terminal-default background (SGR 49), NOT a color:
   plain `transparent` flattens to solid black here because App.render paints a
   Blank of the root color and Textual has nothing beneath the base to composite
   against. For SGR 49 to survive to the terminal, `ansi_color=True` on the App
   (see soap/tui/app.py) disables Textual's ANSI→truecolor filter which would
   otherwise convert `ansi_default` back into an opaque RGB fill.
   This is terminal background passthrough, not emulator opacity control; the
   opaque pane/card rules below keep the UI readable on terminals without
   transparency (and on any terminal, text always sits on an opaque surface). */
App, Screen {
    background: ansi_default;
}

/* --- top bar: brand + search + inbox pill ----------------------------- */

#topbar {
    height: 3;
    background: $surface;
    padding: 0 2;
    align-vertical: middle;
}

#logo {
    width: auto;
    height: 1;
    color: $primary;
    text-style: bold;
    padding: 0 3 0 0;
}

#search {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $surface;
    color: $text-muted;
}
#search:focus {
    background: $panel;
    color: $foreground;
}

#inboxpill {
    width: auto;
    height: 1;
    padding: 0 2;
    background: $accent 15%;
    color: $accent;
    text-style: bold;
}

/* --- three-pane body -------------------------------------------------- */

#body {
    height: 1fr;
    padding: 1 1 0 1;
}

#sidebar {
    width: 26;
    min-width: 22;
    background: $panel;
    border: round $border;
    border-title-color: $text-muted;
    border-title-align: left;
    padding: 0 1;
    margin: 0 1 0 0;
}
#sidebar:focus, #sidebar:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

#doclist {
    width: 3fr;
    background: $panel;
    border: round $border;
    border-title-color: $text-muted;
    border-title-align: left;
    padding: 0 1;
    margin: 0 1 0 0;
    scrollbar-size: 0 0;
}
#doclist:focus {
    border: round $primary;
    border-title-color: $primary;
}

#detail {
    width: 2fr;
    min-width: 32;
    background: $panel;
    border: round $border;
    border-title-color: $text-muted;
    border-title-align: left;
    padding: 0 2;
}
#detail:focus, #detail:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

#detail-body {
    width: 1fr;
}

/* --- document table --------------------------------------------------- */

DataTable > .datatable--header {
    text-style: bold;
    color: $text-muted;
    background: $panel;
}
DataTable > .datatable--cursor {
    background: $primary 30%;
    color: $foreground;
    text-style: bold;
}
DataTable > .datatable--even-row {
    background: $panel;
}
DataTable > .datatable--odd-row {
    background: $boost;
}

/* --- sidebar rows ----------------------------------------------------- */

.side-header-item {
    background: transparent;
    padding: 1 0 0 0;
    height: auto;
}
.side-header {
    color: $text-muted;
    text-style: bold;
}
.side-row {
    layout: horizontal;
    height: 1;
    padding: 0 1;
}
.side-row.attention .side-label,
.side-row.attention .side-count {
    color: $accent;
    text-style: bold;
}
.side-label {
    width: 1fr;
    /* A tag/collection name can be long and unbreakable; the row is height: 1,
       so default word-wrap would push the name onto a hidden second line and a
       no-space tag collapses to a bare "#". Clip to one line with an ellipsis,
       matching the DocumentList columns (no_wrap + overflow="ellipsis"). */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
.side-count {
    width: auto;
    color: $text-muted;
}

/* --- persistent cheat-bar footer -------------------------------------- */

#cheatbar {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 2;
}

/* --- modals: review, help, empty-library ------------------------------ */

ReviewScreen, HelpScreen, TagEditScreen {
    align: center middle;
    background: $background 70%;
}

#review-card, #help-card, #empty-card, #tag-card {
    width: 74;
    max-width: 90%;
    height: auto;
    background: $panel;
    border: round $primary;
    border-title-color: $primary;
    border-title-align: left;
    padding: 1 3;
}

#review-progress {
    height: 1;
}
#review-meter {
    height: auto;
    padding: 0 0 1 0;
}
.field-row {
    height: 3;
}
.field-label {
    width: 9;
    padding: 1 1 0 0;
    text-align: right;
    color: $text-muted;
}
.field-input {
    width: 1fr;
    height: 3;
    background: $background;
    border: tall $border;
    padding: 0 1;
    color: $foreground;
}
.field-input:focus {
    border: tall $primary;
    background: $surface;
}
#review-facts {
    padding: 1 0 0 0;
    color: $text-muted;
}
#review-hint {
    height: auto;
    margin: 1 0 0 0;
    border-top: solid $border;
    padding: 1 0 0 0;
}

/* --- help cheat sheet -------------------------------------------------- */

#help-card {
    width: 92;
}
#help-cols {
    height: auto;
}
.help-col {
    width: 1fr;
    height: auto;
    padding: 0 2 0 0;
}
#help-hint {
    padding: 1 0 0 0;
}

#empty-card {
    border: round $accent;
    border-title-color: $accent;
    content-align: center middle;
    padding: 2 4;
}
